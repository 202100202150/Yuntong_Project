{
  "name": "yuntong-detection-workbench",
  "version": "0.1.1",
  "description": "云瞳 AIRSPACE 低空监测与事件管理平台",
  "author": "云瞳",
  "private": true,
  "type": "module",
  "main": "desktop/product-main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm --prefix ../frontend run dev",
    "build": "npm run desktop:build-renderer",
    "desktop:build-renderer": "node scripts/prepare-product.mjs --renderer-only",
    "desktop:run": "npm run desktop:build-renderer && electron .",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win nsis --x64",
    "lint": "oxlint",
    "dataset:coco-person": "node training/download-coco-person.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "desktop:prepare": "node scripts/prepare-product.mjs",
    "desktop:legacy": "vite build --config desktop/vite.config.ts && node scripts/run-legacy.mjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --dir --win --x64",
    "test:product-runtime": "electron tests/product-runtime-smoke.cjs",
    "test:product-actions": "electron tests/product-actions-smoke.cjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "onnxruntime-web": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "cn.yuntong.detectionworkbench",
    "productName": "云瞳 AIRSPACE",
    "executableName": "YuntongWorkbench",
    "asar": true,
    "asarUnpack": [],
    "extraResources": [
      {
        "to": "runtime",
        "from": "product-runtime"
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "outputs",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/product-main.cjs",
      "desktop/assets/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Yuntong-Detection-Workbench-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "云瞳 AIRSPACE",
      "deleteAppDataOnUninstall": false
    }
  }
}
