# Copy this file to .env. Never commit the real .env file.
# Documentation-only TEST-NET addresses. Replace them in your local .env.
CAMERA1_IP=192.0.2.10
CAMERA2_IP=192.0.2.11
CAMERA_HTTP_PORT=80
CAMERA_RTSP_PORT=554
CAMERA_USERNAME=your_camera_username
CAMERA_PASSWORD=change_me
CAMERA_CHANNEL=1
CAMERA1_LABEL=Camera 1
CAMERA2_LABEL=Camera 2
CAMERA_STREAM=main
CAMERA_TRANSPORT=tcp

# Low-latency tuning. Defaults below are conservative for a wired LAN.
CAMERA_CONNECT_TIMEOUT=5
CAMERA_READ_TIMEOUT=3
CAMERA_ANALYZEDURATION_US=100000
CAMERA_PROBESIZE=65536
CAMERA_BUFFER_SIZE=131072
CAMERA_DECODER_THREADS=0
CAMERA_HWACCEL=none
CAMERA_MAX_BACKLOG=1.5
CAMERA_BACKLOG_FRAMES=5
CAMERA_DISPLAY_WIDTH=960
CAMERA_DISPLAY_HEIGHT=540
CAMERA_SEPARATOR_WIDTH=16
CAMERA_SHOW_STATS=true

# Per-camera full-resolution recording and snapshot destinations.
CAMERA1_OUTPUT_DIR=outputs\camera1
CAMERA2_OUTPUT_DIR=outputs\camera2
CAMERA_SNAPSHOT_FORMAT=png
CAMERA_JPEG_QUALITY=95
CAMERA_PNG_COMPRESSION=3
CAMERA_RECORD_CONTAINER=mp4
CAMERA_RECORD_QUEUE_PACKETS=1024
CAMERA_RECORD_ON_START=false
